# 复制为 .env 后按需填写；全部留空时后端走离线分支，可无网络运行。
# 重要：FRONTEND 与 BACKEND 仅用于合法授权的安全测试。

# 可选：OpenAI 摘要（留空则用离线摘要，结果带 note 标注）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# 可选：Whisper / pyannote
WHISPER_MODEL=large-v3
PYANNOTE_AUTH_TOKEN=

# 加密密钥（留空则「未加密」，接口会如实告知）
ENCRYPTION_KEY=

# 可选：SMTP。留空时邮件发送会如实返回失败，不再谎报成功。
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

API_HOST=0.0.0.0
API_PORT=8000
